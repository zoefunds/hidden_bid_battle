{
  "name": "hidden-bid-battle",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-preserving prediction game on Solana, powered by Arcium",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoefunds/hidden_bid_battle.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@solana/web3.js": "^1.95.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.14.0",
    "chai": "^4.5.0",
    "mocha": "^10.7.0",
    "prettier": "^3.3.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
